{
    "name": "saola/compiler",
    "description": "Saola Compiler - biên dịch .sao sang Blade (SSR) và JavaScript (CSR)",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "saola",
        "compiler",
        "blade",
        "laravel",
        "spa"
    ],
    "authors": [
        {
            "name": "SaoLabs",
            "email": "saolaxoder@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Saola\\Compiler\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Saola\\Compiler\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/saoc"
    ],
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "illuminate/support": "Cần cho SaolaCompilerServiceProvider và lệnh artisan sao:compile (Laravel ^11|^12|^13)",
        "ext-mbstring": "Cần cho hash scope CSS theo codepoint (ScopedStyle)"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Saola\\Compiler\\Laravel\\SaolaCompilerServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "@test:unit",
        "test:unit": "phpunit",
        "lint": "php -l src/SaolaCompiler.php"
    },
    "scripts-descriptions": {
        "test": "Chạy PHPUnit — bộ test chính thức không phụ thuộc Python",
        "test:unit": "PHPUnit — nhánh chính sách và ca biên"
    }
}
